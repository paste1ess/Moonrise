<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Moonrise.Controls.ProgressSlider"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Moonrise.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{x:Bind FormatDuration(playbackService.CurrentTrackTime), Mode=OneWay, FallbackValue='0:00'}" Style="{x:Bind BoolToTextStyle(Small), Mode=OneWay}" VerticalAlignment="Center" TextAlignment="Right" HorizontalAlignment="Right"/>
        <Slider x:Name="ProgressSliderElement" Grid.Column="1" 
            Minimum="0" 
            Maximum="{x:Bind playbackService.CurrentTrack.Duration.TotalSeconds, Mode=OneWay}" 
            Value="{x:Bind playbackService.CurrentTrackTime.TotalSeconds, Mode=OneWay}" 
            VerticalAlignment="Center" 
            Margin="16,0"
            TickFrequency="1"
            TickPlacement="None"
            IsThumbToolTipEnabled="False"
            Loaded="ProgressSlider_Loaded"
            ValueChanged="ProgressSlider_ValueChanged"
        />
        <TextBlock Grid.Column="2" Text="{x:Bind FormatDuration(playbackService.CurrentTrack.Duration), Mode=OneWay, FallbackValue='0:00'}" Style="{x:Bind BoolToTextStyle(Small), Mode=OneWay}" VerticalAlignment="Center" TextAlignment="Left" HorizontalAlignment="Left"/>
    </Grid>
</UserControl>
