<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Moonrise.Controls.TrackList"
    x:Name="TrackListControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Moonrise.Controls"
    xmlns:models="using:Moonrise.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ItemsRepeater x:Name="TrackListRepeater" ItemsSource="{x:Bind Tracks, Mode=OneWay}">
        <ItemsRepeater.ItemTemplate>
            <DataTemplate x:DataType="models:Track">
                <local:TrackListItem Song="{x:Bind}"
                    ArtView="{Binding ArtView, ElementName=TrackListControl}"
                    TrackView="{Binding TrackView, ElementName=TrackListControl}"
                    DisplayAlbum="{Binding DisplayAlbum, ElementName=TrackListControl}"
                    HorizontalAlignment="Stretch" Clicked="TrackListItem_Clicked"/>
            </DataTemplate>
        </ItemsRepeater.ItemTemplate>
        <ItemsRepeater.Layout>
            <StackLayout Orientation="Vertical" Spacing="0"/>
        </ItemsRepeater.Layout>
    </ItemsRepeater>
</UserControl>
