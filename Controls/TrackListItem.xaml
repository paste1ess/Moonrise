<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Moonrise.Controls.TrackListItem"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Moonrise.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Button Background="#00000000"
            BorderThickness="0"
            Padding="6"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            Click="Button_Click">
        <Grid Padding="6,6,12,6" HorizontalAlignment="Stretch" ColumnSpacing="24" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" CornerRadius="4" Height="40" Width="40" Visibility="{x:Bind TrackView, Mode=OneWay}">
                <Image Source="{x:Bind DisplayedCoverArt, Mode=OneWay, TargetNullValue='ms-appx:///Assets/Placeholder.png'}" Stretch="UniformToFill"/>
            </Grid>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="{x:Bind Song.Title, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{x:Bind Song.Artist, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <TextBlock Grid.Column="2" Text="{x:Bind Song.Album, Mode=OneWay}" Style="{StaticResource BodyTextBlockStyle}" VerticalAlignment="Center" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" Visibility="{x:Bind TrackView, Mode=OneWay}"/>

            <TextBlock Grid.Column="3" Text="{x:Bind FormatDuration(Song.Duration), Mode=OneWay}" Style="{StaticResource BodyTextBlockStyle}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
        </Grid>
    </Button>
</UserControl>
