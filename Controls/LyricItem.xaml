<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Name="LyricRoot"
    x:Class="Moonrise.Controls.LyricItem"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Moonrise.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    SizeChanged="UserControl_SizeChanged"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Storyboard x:Name="ActiveStoryboard">
            <DoubleAnimation Storyboard.TargetName="LyricScale"
                             Storyboard.TargetProperty="ScaleX"
                             To="1.25"
                             Duration="0:0:0.35">
                <DoubleAnimation.EasingFunction>
                    <ExponentialEase EasingMode="EaseOut" Exponent="5" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="LyricScale"
                             Storyboard.TargetProperty="ScaleY"
                             To="1.25"
                             Duration="0:0:0.35">
                <DoubleAnimation.EasingFunction>
                    <ExponentialEase EasingMode="EaseOut" Exponent="5" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="TextObject"
                             Storyboard.TargetProperty="Opacity"
                             To="1.0"
                             Duration="0:0:0.35">
                <DoubleAnimation.EasingFunction>
                    <ExponentialEase EasingMode="EaseOut" Exponent="5" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Storyboard x:Name="InactiveStoryboard">
            <DoubleAnimation Storyboard.TargetName="LyricScale"
                             Storyboard.TargetProperty="ScaleX"
                             To="1.0"
                             Duration="0:0:0.35">
                <DoubleAnimation.EasingFunction>
                    <ExponentialEase EasingMode="EaseOut" Exponent="5" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="LyricScale"
                             Storyboard.TargetProperty="ScaleY"
                             To="1.0"
                             Duration="0:0:0.35">
                <DoubleAnimation.EasingFunction>
                    <ExponentialEase EasingMode="EaseOut" Exponent="5" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="TextObject"
                             Storyboard.TargetProperty="Opacity"
                             To="0.4"
                             Duration="0:0:0.35">
                <DoubleAnimation.EasingFunction>
                    <ExponentialEase EasingMode="EaseOut" Exponent="5" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </UserControl.Resources>

    <Grid>
        <TextBlock x:Name="TextObject"
                   Text="{x:Bind Text, Mode=OneWay}"
                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                   FontSize="40"
                   Opacity="0.4"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Left"
                   RenderTransformOrigin="0,0.5"
                   TextWrapping="Wrap">
            <TextBlock.RenderTransform>
                <ScaleTransform x:Name="LyricScale" />
            </TextBlock.RenderTransform>
        </TextBlock>
    </Grid>
</UserControl>
