<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Name="LyricRoot"
    x:Class="Moonrise.Controls.LyricItem"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Moonrise.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="UserControl_Loaded"
    SizeChanged="UserControl_SizeChanged"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Storyboard x:Name="ActiveStoryboard">
            <DoubleAnimation Storyboard.TargetName="LyricScale"
                             Storyboard.TargetProperty="ScaleX"
                             To="1.25"
                             Duration="0:0:0.35">
                <DoubleAnimation.EasingFunction>
                    <ExponentialEase EasingMode="EaseOut" Exponent="5" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="LyricScale"
                             Storyboard.TargetProperty="ScaleY"
                             To="1.25"
                             Duration="0:0:0.35">
                <DoubleAnimation.EasingFunction>
                    <ExponentialEase EasingMode="EaseOut" Exponent="5" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Storyboard x:Name="InactiveStoryboard">
            <DoubleAnimation Storyboard.TargetName="LyricScale"
                             Storyboard.TargetProperty="ScaleX"
                             To="1.0"
                             Duration="0:0:0.35">
                <DoubleAnimation.EasingFunction>
                    <ExponentialEase EasingMode="EaseOut" Exponent="5" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="LyricScale"
                             Storyboard.TargetProperty="ScaleY"
                             To="1.0"
                             Duration="0:0:0.35">
                <DoubleAnimation.EasingFunction>
                    <ExponentialEase EasingMode="EaseOut" Exponent="5" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </UserControl.Resources>

    <Grid x:Name="RootGrid" RenderTransformOrigin="0,0.5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
        <Grid.RenderTransform>
            <ScaleTransform x:Name="LyricScale" />
        </Grid.RenderTransform>
        <Border x:Name="SourceWrapper" Grid.Column="0">
            <Border x:Name="TextSourceHost"
                    Padding="24"
                    Margin="-24"
                    SizeChanged="TextSourceHost_SizeChanged">
                <TextBlock x:Name="TextObject"
                           Text="{x:Bind Text, Mode=OneWay}"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                           FontSize="40"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Left"
                           TextWrapping="Wrap" />
            </Border>
        </Border>
        <Canvas x:Name="BlurHost" Grid.Column="0" Margin="-24" IsHitTestVisible="False" />
    </Grid>
</UserControl>
