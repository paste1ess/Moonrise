<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Moonrise.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:local="using:Moonrise"
    xmlns:models="using:Moonrise.Models"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Moonrise"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid KeyDown="RootGrid_KeyDown" SizeChanged="RootGrid_SizeChanged">
        <Grid>
            <canvas:CanvasControl
                x:Name="BackgroundCanvas"
                IsHitTestVisible="False"
                Opacity="0">
                <canvas:CanvasControl.OpacityTransition>
                    <ScalarTransition Duration="0:0:0.35"/>
                </canvas:CanvasControl.OpacityTransition>
            </canvas:CanvasControl>
            <canvas:CanvasControl
                x:Name="ShaderCanvas"
                IsHitTestVisible="False"
                Opacity="0">
                <canvas:CanvasControl.OpacityTransition>
                    <ScalarTransition Duration="0:0:0.35"/>
                </canvas:CanvasControl.OpacityTransition>
            </canvas:CanvasControl>
        </Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TitleBar
                x:Name="AppTitleBar"
                Title="Moonrise (beta)"
                IsBackButtonVisible="False"
                IsPaneToggleButtonVisible="True"
                PaneToggleRequested="TitleBar_PaneToggleRequested">
                <TitleBar.IconSource>
                    <FontIconSource Glyph="&#xEC4F;" Foreground="{StaticResource AccentTextFillColorPrimaryBrush}"/>
                </TitleBar.IconSource>
                <TitleBar.RightHeader>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <StackPanel x:Name="NowPlayingPanel" VerticalAlignment="Center" Margin="0,0,16,0" IsHitTestVisible="False">
                            <TextBlock Text="{x:Bind PlaybackService.CurrentTrack.Title, Mode=OneWay}" TextAlignment="Right"/>
                            <TextBlock Text="{x:Bind PlaybackService.CurrentTrack.Artist, Mode=OneWay}" TextAlignment="Right" FontSize="11"/>
                        </StackPanel>
                        <AppBarSeparator x:Name="NowPlayingSeparator" IsHitTestVisible="False"/>
                        <StackPanel x:Name="PlaybackButtonsPanel" Orientation="Horizontal" Spacing="8">
                            <Button
                                Click="RewindButton_Click"
                                Width="50"
                                Padding="0"
                                VerticalAlignment="Stretch"
                                Style="{StaticResource SubtleButtonStyle}">
                                <FontIcon Glyph="&#xE892;" FontSize="16"/>
                            </Button>
                            <Button
                                Click="PlayPauseButton_Click"
                                Width="50"
                                Padding="0"
                                VerticalAlignment="Stretch"
                                Style="{StaticResource SubtleButtonStyle}">
                                <FontIcon Glyph="{x:Bind PlaybackStateToGlyph(PlaybackService.CurrentPlaybackState), Mode=OneWay}" FontSize="16"/>
                            </Button>
                            <Button
                                Click="SkipButton_Click"
                                Width="50"
                                Padding="0"
                                VerticalAlignment="Stretch"
                                Style="{StaticResource SubtleButtonStyle}">
                                <FontIcon Glyph="&#xE893;" FontSize="16"/>
                            </Button>
                            <AppBarSeparator IsHitTestVisible="False"/>
                        </StackPanel>

                        <Grid Height="44" VerticalAlignment="Stretch" Margin="0,2">
                            <Button x:Name="PlayerNavButton"
                                Click="PlayerNavButton_Click"
                                Width="50"
                                Padding="0"
                                VerticalAlignment="Stretch"
                                Style="{StaticResource SubtleButtonStyle}">
                                <FontIcon Glyph="&#xE786;" FontSize="16"/>
                            </Button>

                            <Rectangle x:Name="PlayerNavIndicator"
                                Width="16"
                                Height="3"
                                RadiusX="2"
                                RadiusY="2"
                                VerticalAlignment="Bottom"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,2"
                                Fill="{ThemeResource NavigationViewSelectionIndicatorForeground}"
                                Visibility="Collapsed"/>
                        </Grid>
                    </StackPanel>
                </TitleBar.RightHeader>

            </TitleBar>

            <NavigationView
                x:Name="NavView"
                Grid.Row="1"
                IsBackButtonVisible="Collapsed"
                IsPaneToggleButtonVisible="False"
                SelectionChanged="NavView_SelectionChanged">
                <NavigationView.MenuItems>
                    <NavigationViewItem
                        Content="Home"
                        Tag="home">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE80F;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>

                    <NavigationViewItemSeparator/>
                    
                    <NavigationViewItem Content="Tracks" Tag="tracks">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE90B;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="Albums" Tag="albums">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE93C;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="Artists" Tag="artists">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE716;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>

                    <NavigationViewItemSeparator/>

                    <NavigationViewItem Content="Favorites" Tag="favorites">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE728;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="Playlists" Tag="artists">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xF168;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.MenuItems>
                <Frame x:Name="NavFrame" CacheSize="0" />
            </NavigationView>
        </Grid>
        <ItemsControl
            ItemsSource="{x:Bind ToastService.ActiveToasts, Mode=OneWay}"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="0,56,0,0"
            Canvas.ZIndex="1000"
            IsHitTestVisible="True">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:ToastModel">
                    <InfoBar
                        IsOpen="{x:Bind IsOpen, Mode=TwoWay}"
                        Severity="{x:Bind Severity, Mode=OneWay}"
                        IsClosable="{x:Bind IsClosable, Mode=OneWay}"
                        CloseButtonClick="Toast_CloseButtonClick"
                        Tag="{x:Bind}"
                        Margin="0,0,0,8"
                        HorizontalAlignment="Center">
                        <InfoBar.Content>
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <TextBlock
                                    Text="{x:Bind Message, Mode=OneWay}"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    VerticalAlignment="Center" />
                                <ProgressBar
                                    Width="80"
                                    Height="3"
                                    CornerRadius="1.5"
                                    IsIndeterminate="{x:Bind IsIndeterminate, Mode=OneWay}"
                                    Value="{x:Bind Progress, Mode=OneWay}"
                                    Opacity="{x:Bind ProgressBarOpacity, Mode=OneWay}"
                                    Visibility="{x:Bind ProgressBarVisibility, Mode=OneWay}"
                                    VerticalAlignment="Center">
                                    <ProgressBar.OpacityTransition>
                                        <ScalarTransition Duration="0:0:0.3"/>
                                    </ProgressBar.OpacityTransition>
                                </ProgressBar>
                            </StackPanel>
                        </InfoBar.Content>
                    </InfoBar>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
