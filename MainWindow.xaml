<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Moonrise.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:local="using:Moonrise"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Moonrise"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid>
            <Image x:Name="BackgroundArtworkImage"
                Source="{x:Bind PlaybackService.CurrentTrackBackgroundArtwork, Mode=OneWay}"
                Stretch="Fill"
                IsHitTestVisible="False"
                Opacity="{x:Bind CheckBackgroundOpacity(PlaybackService.CurrentPlaybackState, PlaybackService.CurrentTrackBackgroundArtwork, _isWindowFocused, _isLightTheme), Mode=OneWay}">
                <Image.OpacityTransition>
                    <ScalarTransition Duration="0:0:0.35"/>
                </Image.OpacityTransition>
            </Image>
            <canvas:CanvasControl
                x:Name="ShaderCanvas"/>
        </Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TitleBar
                x:Name="AppTitleBar"
                Title="Moonrise"
                IsBackButtonVisible="False"
                IsPaneToggleButtonVisible="True"
                PaneToggleRequested="TitleBar_PaneToggleRequested">
                <TitleBar.IconSource>
                    <FontIconSource Glyph="&#xEC4F;" Foreground="{StaticResource AccentTextFillColorPrimaryBrush}"/>
                </TitleBar.IconSource>
                <TitleBar.RightHeader>
                    <Grid Height="44" VerticalAlignment="Stretch" Margin="0,2">
                        <Button x:Name="PlayerNavButton"
                            Click="PlayerNavButton_Click"
                            Width="40"
                            Padding="0"
                            VerticalAlignment="Stretch"
                            Style="{StaticResource SubtleButtonStyle}">
                            <FontIcon Glyph="&#xE786;" FontSize="16"/>
                        </Button>

                        <Rectangle x:Name="PlayerNavIndicator"
                            Width="16"
                            Height="3"
                            RadiusX="2"
                            RadiusY="2"
                            VerticalAlignment="Bottom"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,2"
                            Fill="{ThemeResource NavigationViewSelectionIndicatorForeground}"
                            Visibility="Collapsed"/>
                    </Grid>
                </TitleBar.RightHeader>
            </TitleBar>

            <NavigationView
                x:Name="NavView"
                Grid.Row="1"
                IsBackButtonVisible="Collapsed"
                IsPaneToggleButtonVisible="False"
                SelectionChanged="NavView_SelectionChanged">
                <NavigationView.MenuItems>
                    <NavigationViewItem
                        Content="Home"
                        Tag="home">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE80F;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>

                    <NavigationViewItemSeparator/>
                    
                    <NavigationViewItem Content="Tracks" Tag="tracks">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE90B;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="Albums" Tag="albums">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE93C;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="Artists" Tag="artists">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE716;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>

                    <NavigationViewItemSeparator/>

                    <NavigationViewItem Content="Favorites" Tag="favorites">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE728;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="Playlists" Tag="artists">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xF168;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.MenuItems>
                <Frame x:Name="NavFrame" />
            </NavigationView>
        </Grid>
    </Grid>
</Window>
