<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Moonrise.Pages.ArtistItemPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Moonrise.Pages"
    xmlns:models="using:Moonrise.Models"
    xmlns:controls="using:Moonrise.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="600" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HeaderPanel.Orientation" Value="Horizontal" />
                        <Setter Target="HeaderPanel.HorizontalAlignment" Value="Left" />
                        <Setter Target="ArtistCoverContainer.HorizontalAlignment" Value="Left" />
                        <Setter Target="ArtistInfoPanel.VerticalAlignment" Value="Bottom" />
                        <Setter Target="ArtistInfoPanel.HorizontalAlignment" Value="Left" />
                        <Setter Target="ArtistTextPanel.HorizontalAlignment" Value="Left" />
                        <Setter Target="ArtistNameTextBlock.TextAlignment" Value="Left" />
                        <Setter Target="ArtistNameTextBlock.HorizontalAlignment" Value="Left" />
                        <Setter Target="ButtonsPanel.HorizontalAlignment" Value="Left" />
                        <Setter Target="AlbumGridView.HorizontalAlignment" Value="Stretch" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HeaderPanel.Orientation" Value="Vertical" />
                        <Setter Target="HeaderPanel.HorizontalAlignment" Value="Center" />
                        <Setter Target="ArtistCoverContainer.HorizontalAlignment" Value="Center" />
                        <Setter Target="ArtistInfoPanel.VerticalAlignment" Value="Center" />
                        <Setter Target="ArtistInfoPanel.HorizontalAlignment" Value="Center" />
                        <Setter Target="ArtistTextPanel.HorizontalAlignment" Value="Center" />
                        <Setter Target="ArtistNameTextBlock.TextAlignment" Value="Center" />
                        <Setter Target="ArtistNameTextBlock.HorizontalAlignment" Value="Center" />
                        <Setter Target="ButtonsPanel.HorizontalAlignment" Value="Center" />
                        <Setter Target="AlbumGridView.HorizontalAlignment" Value="Center" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <ScrollViewer Padding="24,16,24,0" MaxWidth="1400">
            <StackPanel Margin="0,0,0,16" Spacing="32">
                <StackPanel x:Name="HeaderPanel" Orientation="Horizontal" VerticalAlignment="Stretch" Spacing="24">
                    <Grid x:Name="ArtistCoverContainer" CornerRadius="160" Width="320" Height="320">
                        <Image x:Name="ArtistCoverImage" Source="{x:Bind ArtistArt, Mode=OneWay, TargetNullValue='ms-appx:///Assets/Placeholder.png'}" Stretch="UniformToFill"/>
                    </Grid>
                    <StackPanel x:Name="ArtistInfoPanel" VerticalAlignment="Bottom" Spacing="24">
                        <StackPanel x:Name="ArtistTextPanel" VerticalAlignment="Center">
                            <TextBlock x:Name="ArtistNameTextBlock" Text="{x:Bind DisplayedArtist.Name}" Style="{StaticResource TitleTextBlockStyle}"/>
                        </StackPanel>
                        <StackPanel x:Name="ButtonsPanel" Orientation="Horizontal" Spacing="8">
                            <Button Style="{ThemeResource AccentButtonStyle}" Click="PlayButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="12" Padding="4">
                                    <FontIcon Glyph="&#xE768;"/>
                                    <TextBlock Text="Play"/>
                                </StackPanel>
                            </Button>
                            <Button Click="ShuffleButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="12" Padding="4">
                                    <FontIcon Glyph="&#xE8B1;"/>
                                    <TextBlock Text="Shuffle"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <GridView x:Name="AlbumGridView"
                          Padding="0,0,16,16"
                          Background="Transparent"
                          ItemsSource="{x:Bind Albums, Mode=OneWay}"
                          SelectionMode="None">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="models:Album">
                            <controls:AlbumGridItem Album="{x:Bind}" Click="AlbumGridItem_Clicked"/>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
