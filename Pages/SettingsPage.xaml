<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Moonrise.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Moonrise.Pages"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">



    <Grid Padding="24,16,24,0" RowSpacing="24" MaxWidth="1000" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock x:Uid="SettingsPage_Title" Style="{StaticResource TitleTextBlockStyle}" />
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="16" Padding="0,0,0,16">
                <TextBlock x:Uid="SettingsPage_LibrarySection" Style="{StaticResource SubtitleTextBlockStyle}"/>
                <StackPanel Spacing="4">
                    <controls:SettingsCard
                        x:Uid="SettingsPage_LibraryFolderCard">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE8B7;" />
                        </controls:SettingsCard.HeaderIcon>
                        <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind _settings.MusicLibraryPath, Mode=OneWay}" VerticalAlignment="Center"/>
                            <Button x:Uid="SettingsPage_ChooseFolderButton" Click="ChooseFolder_Click" VerticalAlignment="Center"/>
                        </StackPanel>
                    </controls:SettingsCard>

                    <controls:SettingsExpander
                        x:Uid="SettingsPage_RescanLibraryExpander">
                        <controls:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xE8F7;" />
                        </controls:SettingsExpander.HeaderIcon>
                        <Button x:Name="RescanButton" x:Uid="SettingsPage_RescanButton" Click="RescanButton_Click"/>
                        <controls:SettingsExpander.Items>
                            <controls:SettingsCard
                                x:Uid="SettingsPage_HardResetCard">
                                <controls:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xE7BA;" />
                                </controls:SettingsCard.HeaderIcon>
                                <Button x:Name="ScanButton" x:Uid="SettingsPage_HardResetButton" Click="ScanNow_Click"/>
                            </controls:SettingsCard>
                        </controls:SettingsExpander.Items>
                    </controls:SettingsExpander>

                    
                </StackPanel>

                <TextBlock x:Uid="SettingsPage_VisualSection" Style="{StaticResource SubtitleTextBlockStyle}"/>
                <StackPanel Spacing="4">
                    <controls:SettingsCard
                        x:Uid="SettingsPage_ThemeCard">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE790;" />
                        </controls:SettingsCard.HeaderIcon>
                        <ComboBox x:Name="ThemeComboBox" SelectionChanged="ThemeComboBox_SelectionChanged" MinWidth="150">
                            <ComboBoxItem x:Uid="SettingsPage_ThemeAuto" Tag="Default" />
                            <ComboBoxItem x:Uid="SettingsPage_ThemeLight" Tag="Light" />
                            <ComboBoxItem x:Uid="SettingsPage_ThemeDark" Tag="Dark" />
                        </ComboBox>
                    </controls:SettingsCard>

                    <controls:SettingsExpander
                        x:Uid="SettingsPage_MicaPlusExpander"
                        Header="Mica+"
                        IsExpanded="{x:Bind _settings.BackgroundShadersEnabled, Mode=OneWay}">

                        <controls:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xEF1F;" />
                        </controls:SettingsExpander.HeaderIcon>

                        <controls:SettingsExpander.Content>
                            <ToggleSwitch IsOn="{x:Bind _settings.BackgroundShadersEnabled, Mode=TwoWay}"/>
                        </controls:SettingsExpander.Content>

                        <controls:SettingsExpander.Items>
                            <controls:SettingsCard x:Uid="SettingsPage_BatteryKillerCard">
                                <ToggleSwitch IsOn="{x:Bind _settings.BackgroundShadersBoostFps, Mode=TwoWay}"/>
                            </controls:SettingsCard>
                        </controls:SettingsExpander.Items>

                    </controls:SettingsExpander>
                </StackPanel>

                <TextBlock x:Uid="SettingsPage_ConnectivitySection" Style="{StaticResource SubtitleTextBlockStyle}"/>
                <StackPanel Spacing="4">
                    <controls:SettingsCard
                        x:Uid="SettingsPage_DiscordCard">

                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE704;" />
                        </controls:SettingsCard.HeaderIcon>

                        <controls:SettingsCard.Content>
                            <ToggleSwitch IsOn="{x:Bind _settings.DiscordRpcEnabled, Mode=TwoWay}"/>
                        </controls:SettingsCard.Content>
                    </controls:SettingsCard>
                </StackPanel>

                <TextBlock x:Uid="SettingsPage_AboutSection" Style="{StaticResource SubtitleTextBlockStyle}"/>
                <controls:SettingsExpander Header="Moonrise (beta) 🌙" Description="v0.2.0">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xEC4F;" />
                    </controls:SettingsExpander.HeaderIcon>

                    <controls:SettingsExpander.Content>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Stretch" HorizontalAlignment="Center">
                            <TextBlock x:Uid="SettingsPage_MadeWithLove" VerticalAlignment="Center"/>
                        </StackPanel>
                    </controls:SettingsExpander.Content>

                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard x:Uid="SettingsPage_CreditsCard">
                            <controls:SettingsCard.Description>
                                <TextBlock x:Uid="SettingsPage_CreditsDescription" />
                            </controls:SettingsCard.Description>
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Uid="SettingsPage_SourceCard">
                            <HyperlinkButton x:Uid="SettingsPage_GitHubLink" NavigateUri="https://github.com/paste1ess/Moonrise"/>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
