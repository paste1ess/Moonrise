<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Moonrise.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Moonrise.Pages"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">



    <Grid Padding="24,16,24,0" RowSpacing="24" MaxWidth="1000" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Settings" />
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="16" Padding="0,0,0,16">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Library"/>
                <StackPanel Spacing="4">
                    <controls:SettingsCard
                        Header="Library Folder"
                        Description="Sets the library folder to a specific path">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE8B7;" />
                        </controls:SettingsCard.HeaderIcon>
                        <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind _settings.MusicLibraryPath, Mode=OneWay}" VerticalAlignment="Center"/>
                            <Button Content="Choose Folder" Click="ChooseFolder_Click" VerticalAlignment="Center"/>
                        </StackPanel>
                    </controls:SettingsCard>

                    <controls:SettingsExpander
                        Header="Rescan Library"
                        Description="Updates your library by scanning for changes in your files">
                        <controls:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xE8F7;" />
                        </controls:SettingsExpander.HeaderIcon>
                        <Button x:Name="RescanButton" Content="Rescan" Click="RescanButton_Click"/>
                        <controls:SettingsExpander.Items>
                            <controls:SettingsCard
                                Header="Hard Reset Library"
                                Description="Resets the database and re-scans the entire library folder. WILL cause loss of favorites and play counts!">
                                <controls:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xE7BA;" />
                                </controls:SettingsCard.HeaderIcon>
                                <Button x:Name="ScanButton" Content="Hard Reset" Click="ScanNow_Click"/>
                            </controls:SettingsCard>
                        </controls:SettingsExpander.Items>
                    </controls:SettingsExpander>

                    
                </StackPanel>

                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Visual"/>
                <StackPanel Spacing="4">
                    <controls:SettingsCard
                        Header="Theme"
                        Description="Select which app theme to display">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE790;" />
                        </controls:SettingsCard.HeaderIcon>
                        <ComboBox x:Name="ThemeComboBox" SelectionChanged="ThemeComboBox_SelectionChanged" MinWidth="150">
                            <ComboBoxItem Content="Auto" Tag="Default" />
                            <ComboBoxItem Content="Light" Tag="Light" />
                            <ComboBoxItem Content="Dark" Tag="Dark" />
                        </ComboBox>
                    </controls:SettingsCard>

                    <controls:SettingsExpander
                        Header="Mica+"
                        Description="Enables a custom background effect that efficiently takes advantage of your system to create more dynamic visuals"
                        IsExpanded="{x:Bind _settings.BackgroundShadersEnabled, Mode=OneWay}">

                        <controls:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xEF1F;" />
                        </controls:SettingsExpander.HeaderIcon>

                        <controls:SettingsExpander.Content>
                            <ToggleSwitch IsOn="{x:Bind _settings.BackgroundShadersEnabled, Mode=TwoWay}"/>
                        </controls:SettingsExpander.Content>

                        <controls:SettingsExpander.Items>
                            <controls:SettingsCard Header="Battery Killer Mode"
                   Description="Increases animation smoothness to 60 FPS. Not recommended on battery.">
                                <ToggleSwitch IsOn="{x:Bind _settings.BackgroundShadersBoostFps, Mode=TwoWay}"/>
                            </controls:SettingsCard>
                        </controls:SettingsExpander.Items>

                    </controls:SettingsExpander>
                </StackPanel>

                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Connectivity"/>
                <StackPanel Spacing="4">
                    <controls:SettingsCard
                        Header="Discord Status Integration"
                        Description="Allows Discord to display your currently playing song on your profile">

                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE704;" />
                        </controls:SettingsCard.HeaderIcon>

                        <controls:SettingsCard.Content>
                            <ToggleSwitch IsOn="{x:Bind _settings.DiscordRpcEnabled, Mode=TwoWay}"/>
                        </controls:SettingsCard.Content>
                    </controls:SettingsCard>
                </StackPanel>

                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="About"/>
                <controls:SettingsExpander Header="Moonrise (beta) 🌙" Description="v0.2.0">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xEC4F;" />
                    </controls:SettingsExpander.HeaderIcon>

                    <controls:SettingsExpander.Content>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Stretch" HorizontalAlignment="Center">
                            <TextBlock Text="Made with ❤️" VerticalAlignment="Center"/>
                        </StackPanel>
                    </controls:SettingsExpander.Content>

                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard Header="Credits">
                            <controls:SettingsCard.Description>
                                <TextBlock Text="jamied - most of the dev work" />
                            </controls:SettingsCard.Description>
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="Source">
                            <HyperlinkButton Content="GitHub Repository" NavigateUri="https://github.com/paste1ess/Moonrise"/>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
