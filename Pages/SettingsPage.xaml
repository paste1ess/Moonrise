<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Moonrise.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Moonrise.Pages"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24,16,24,16" RowSpacing="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Settings" />
        <StackPanel Grid.Row="1">
            <controls:SettingsCard 
                Header="Mica+" 
                Description="Enable a custom shader that efficiently takes advantage of Mica to create a more dynamic background">

                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xEF1F;" />
                </controls:SettingsCard.HeaderIcon>

                <ToggleSwitch IsOn="{x:Bind _settings.BackgroundShadersEnabled, Mode=TwoWay}"/>
            </controls:SettingsCard>
        </StackPanel>

    </Grid>
</Page>
